@model List<PhraseBookk.Models.Phrase>
@{
    ViewData["Title"] = "Survival Phrases";
}

<div class="container" style="max-width: 900px;">

    <!-- ===== HEADER ===== -->
    <div class="py-4">
        <div class="d-flex align-items-center gap-3">
            <span style="font-size: 2rem;">🆘</span>
            <div>
                <h1 style="font-size: 1.8rem; font-weight: 700; color: #1a1a2e; margin: 0;">
                    Survival Phrases
                </h1>
                <p style="color: #6c757d; margin: 0; font-size: 0.95rem;">
                    Essential phrases every new DUT student should know
                </p>
            </div>
        </div>
    </div>

    <!-- ===== STATS ===== -->
    <div class="mb-4">
        <span style="background: #f8f9fa; padding: 4px 16px; border-radius: 20px; font-size: 0.8rem; color: #6c757d;">
            @Model.Count phrases
        </span>
    </div>

    <!-- ===== SURVIVAL PHRASES LIST ===== -->
    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var phrase in Model)
            {
                <div class="col-md-6">
                    <a href="/Survival/Details/@phrase.Id" class="text-decoration-none">
                        <div class="card border-0 shadow-sm"
                             style="border-radius: 12px; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <span style="font-size: 1.2rem;">🆘</span>
                                    <div>
                                        <div style="font-weight: 500; color: #1a1a2e; font-size: 1rem;">
                                            @phrase.EnglishText
                                        </div>
                                        <div style="font-size: 0.7rem; color: #6c757d; margin-top: 2px;">
                                            @if (phrase.Category != null)
                                            {
                                                <span>@phrase.Category.Name</span>
                                            }
                                            @if (phrase.Translations != null && phrase.Translations.Any(t => t.Status == PhraseBookk.Models.ContentStatus.Approved))
                                            {
                                                <span style="color: #28a745; margin-left: 8px;">
                                                    ● @phrase.Translations.Count(t => t.Status == PhraseBookk.Models.ContentStatus.Approved) translations
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <!-- ===== EMPTY STATE ===== -->
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 16px;">🆘</div>
            <h3 style="font-weight: 600; color: #1a1a2e;">No survival phrases yet</h3>
            <p style="color: #6c757d; max-width: 400px; margin: 0 auto;">
                Admin can mark phrases as "Survival" to help new students.
            </p>
        </div>
    }

    <!-- ===== BACK TO HOME ===== -->
    <div class="mt-4 pt-3" style="border-top: 1px solid #f0f0f0;">
        <a asp-controller="Home" asp-action="Index" style="color: #6c757d; text-decoration: none; font-size: 0.9rem;">
            ← Back to Home
        </a>
    </div>

</div>

<style>
    .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
        border-color: #dc3545 !important;
    }
</style>