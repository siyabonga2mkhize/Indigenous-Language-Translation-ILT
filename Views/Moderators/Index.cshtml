@model IEnumerable<PhraseBookk.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Moderators";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>👥 Manage Moderators</h1>
            <p class="text-muted">Assign moderator roles to users. Moderators can only approve translations in their assigned language.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">@Model.Count() users</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Moderator?</th>
                            <th>Language</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var languages = new[] { "zu", "xh", "st", "nso", "tn", "ts", "ss", "ve", "nr", "af", "en" };
                            <tr>
                                <td>
                                    <strong>@(user.FullName ?? "No Name")</strong>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsModerator)
                                    {
                                        <span class="badge bg-success">✅ Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">❌ No</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.ModeratorLanguage))
                                    {
                                        <span class="badge bg-info">@user.ModeratorLanguage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Toggle" method="post" class="d-flex gap-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="language" class="form-select form-select-sm" style="width:auto; min-width:80px;">
                                            <option value="">—</option>
                                            @foreach (var lang in languages)
                                            {
                                                <option value="@lang" selected="@(user.ModeratorLanguage == lang)">
                                                    @lang
                                                </option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm @(user.IsModerator ? "btn-danger" : "btn-success")">
                                            @(user.IsModerator ? "Remove" : "Assign")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="PhrasesAdmin" asp-action="Index" class="btn btn-secondary">
            ← Back to Dashboard
        </a>
    </div>
</div>