@model IEnumerable<PhraseBookk.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Moderators";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>👥 Manage Moderators</h1>
            <p class="text-muted">Assign moderator roles to users. Moderators can only approve translations in their assigned language.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">@Model.Count() users</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Moderator?</th>
                            <th>Language</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(user.FullName ?? "No Name")</strong>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsModerator)
                                    {
                                        <span class="badge bg-success">✅ Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">❌ No</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsModerator && !string.IsNullOrEmpty(user.ModeratorLanguage))
                                    {
                                        var langName = user.ModeratorLanguage switch
                                        {
                                            "zu" => "isiZulu",
                                            "xh" => "isiXhosa",
                                            "af" => "Afrikaans",
                                            "en" => "English",
                                            "st" => "Sesotho",
                                            "nso" => "Sepedi",
                                            "tn" => "Setswana",
                                            "ts" => "Xitsonga",
                                            "ss" => "siSwati",
                                            "ve" => "Tshivenda",
                                            "nr" => "isiNdebele",
                                            _ => user.ModeratorLanguage
                                        };
                                        <span class="badge bg-info">@langName</span>
                                    }
                                    else if (!user.IsModerator)
                                    {
                                        // ✅ DROPDOWN IN LANGUAGE COLUMN (only for non-moderators)
                                        <form asp-action="Toggle" method="post" class="d-inline" id="langForm-@user.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="language" class="form-select form-select-sm" style="width:auto; min-width:120px;" onchange="document.getElementById('langForm-@user.Id').submit();">
                                                <option value="">Select Language</option>
                                                <option value="zu">isiZulu</option>
                                                <option value="xh">isiXhosa</option>
                                                <option value="af">Afrikaans</option>
                                                <option value="en">English</option>
                                                <option value="st">Sesotho</option>
                                                <option value="nso">Sepedi</option>
                                                <option value="tn">Setswana</option>
                                                <option value="ts">Xitsonga</option>
                                                <option value="ss">siSwati</option>
                                                <option value="ve">Tshivenda</option>
                                                <option value="nr">isiNdebele</option>
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsModerator)
                                    {
                                        //  ACTION COLUMN ONLY HAS REMOVE BUTTON
                                        <form asp-action="Toggle" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="hidden" name="language" value="@user.ModeratorLanguage" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Remove
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="PhrasesAdmin" asp-action="Index" class="btn btn-secondary">
            ← Back to Dashboard
        </a>
    </div>
</div>