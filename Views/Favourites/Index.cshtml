@model IEnumerable<PhraseBookk.Models.Favorite>
@{
    ViewData["Title"] = "My Favourites";
    var totalFavourites = Model.Count();
}
<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-star-fill text-warning"></i> My Favourites</h1>
            <p>Your saved phrases for quick reference.</p>
        </div>
        <span class="badge-soft">@totalFavourites phrase@(totalFavourites == 1 ? "" : "s")</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-heart"></i></div>
            <h3>No favourites yet</h3>
            <p>Start saving phrases you use often by tapping the heart icon on any phrase's details page.</p>
            <a asp-controller="Phrases" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-search"></i> Search for phrases
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var favorite in Model)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card app-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-2">@favorite.Phrase?.EnglishText</h5>
                                <form asp-controller="Favourites" asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@favorite.Id" />
                                    <button type="submit" class="icon-btn" title="Remove from favourites"
                                            onclick="return confirm('Remove this phrase from your favourites?')">
                                        <i class="bi bi-heart-fill"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="mb-2">
                                <span class="badge-soft">@favorite.Phrase?.Category?.Name</span>
                            </div>
                            <p class="small text-muted mb-0">
                                <i class="bi bi-clock-history"></i> Saved @favorite.SavedDate.ToString("dd MMM yyyy")
                            </p>
                        </div>
                        <div class="card-footer">
                            <a asp-controller="Phrases" asp-action="Details" asp-route-id="@favorite.PhraseId" class="btn btn-sm btn-outline-primary w-100">
                                View full phrase <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Phrases" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to search
        </a>
    </div>
</div>