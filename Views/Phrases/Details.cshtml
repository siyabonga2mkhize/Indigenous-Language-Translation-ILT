@using PhraseBookk.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model PhraseBookk.Models.Phrase
@{
    ViewBag.Title = "Phrase Details";
    var isFavourited = ViewBag.IsFavourited ?? false;
}

<div class="container mt-4">
    <h2>Phrase details</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header" style="background: var(--indigo-dark, #1e1b4b); color: #fff;">
            <h3 class="card-title mb-0">@Model.EnglishText</h3>
        </div>
        <div class="card-body">
            <p><strong>Category:</strong> @(Model.Category?.Name ?? "Uncategorized")</p>

            @if (!string.IsNullOrEmpty(Model.Category?.Latitude) && !string.IsNullOrEmpty(Model.Category?.Longitude))
            {
                <p>
                    <strong>📍 Location:</strong>
                    <a href="https://www.google.com/maps?q=@Model.Category.Latitude,@Model.Category.Longitude"
                       target="_blank"
                       class="btn btn-sm btn-outline-info">
                        View on map
                    </a>
                    <span class="text-muted small ms-2">@Model.Category.MapLocationName</span>
                </p>
            }

            <p><strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")</p>
            <p><strong>Created:</strong> @Model.CreatedDate.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    <h3 class="mt-4">Translations</h3>

    @if (Model.Translations != null && Model.Translations.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Translation</th>
                    <th>Status</th>
                    <th>Votes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trans in Model.Translations.Where(t => t.Status == ContentStatus.Approved).OrderByDescending(t => t.Score))
                {
                    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    var userVote = trans.Votes?.FirstOrDefault(v => v.UserId == userId);
                    var isUpvoted = userVote?.IsUpvote == true;
                    var isDownvoted = userVote?.IsUpvote == false;

                    <tr>
                        <td><span class="badge" data-lang="@trans.Language.ToString()">@trans.Language.ToString()</span></td>
                        <td>@trans.TranslatedText</td>
                        <td><span class="badge bg-success">Approved</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <!-- 👍 UP VOTE -->
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Votes" asp-action="Toggle" method="post" class="d-inline" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="translationId" value="@trans.Id" />
                                        <input type="hidden" name="isUpvote" value="true" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-sm @(isUpvoted ? "btn-success" : "btn-outline-secondary")"
                                                style="border-radius: 20px; padding: 2px 10px; font-size: 0.75rem; min-width: 50px;">
                                            👍 @trans.UpvoteCount
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark" style="font-size: 0.75rem; padding: 4px 10px;">
                                        👍 @trans.UpvoteCount
                                    </span>
                                }

                                <!-- 👎 DOWN VOTE -->
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Votes" asp-action="Toggle" method="post" class="d-inline" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="translationId" value="@trans.Id" />
                                        <input type="hidden" name="isUpvote" value="false" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-sm @(isDownvoted ? "btn-danger" : "btn-outline-secondary")"
                                                style="border-radius: 20px; padding: 2px 10px; font-size: 0.75rem; min-width: 50px;">
                                            👎 @trans.DownvoteCount
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark" style="font-size: 0.75rem; padding: 4px 10px;">
                                        👎 @trans.DownvoteCount
                                    </span>
                                }

                                <!-- Score -->
                                <span class="badge @(trans.Score > 0 ? "bg-success" : (trans.Score < 0 ? "bg-danger" : "bg-secondary"))"
                                      style="font-size: 0.7rem; padding: 4px 10px;">
                                    Score: @trans.Score
                                </span>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    onclick="speakText('@trans.TranslatedText', '@trans.Language.ToString()')"
                                    title="Listen to pronunciation">
                                🔊
                            </button>
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="copyToClipboard('@trans.TranslatedText')"
                                    title="Copy to clipboard">
                                📋
                            </button>
                        </td>
                    </tr>
                }
                @foreach (var trans in Model.Translations.Where(t => t.Status == ContentStatus.Pending))
                {
                    <tr>
                        <td><span class="badge bg-warning">@trans.Language.ToString()</span></td>
                        <td>@trans.TranslatedText</td>
                        <td><span class="badge bg-warning">Pending</span></td>
                        <td><span class="text-muted" style="font-size: 0.75rem;">⏳ Awaiting approval</span></td>
                        <td></td>
                    </tr>
                }
                @foreach (var trans in Model.Translations.Where(t => t.Status == ContentStatus.Rejected))
                {
                    <tr>
                        <td><span class="badge bg-danger">@trans.Language.ToString()</span></td>
                        <td>@trans.TranslatedText</td>
                        <td><span class="badge bg-danger">Rejected</span></td>
                        <td><span class="text-muted" style="font-size: 0.75rem;">❌ Rejected</span></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No translations available for this phrase.</div>
    }

    <div class="mt-3 d-flex flex-wrap gap-2">
        <a asp-controller="Phrases" asp-action="Index" class="btn btn-secondary">
            ← Back to search
        </a>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-action="SubmitTranslation" asp-route-id="@Model.Id" class="btn btn-success">
                ✏️ Suggest translation
            </a>

            <button type="button" id="favouriteBtn" class="btn @(isFavourited ? "btn-danger" : "btn-outline-danger")" onclick="toggleFavourite(@Model.Id)">
                <span id="favouriteIcon">@(isFavourited ? "❤️" : "🤍")</span>
                <span id="favouriteText">@(isFavourited ? " Favourited" : " Favourite")</span>
            </button>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">
                🔑 Login to suggest
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ========== COPY TO CLIPBOARD ==========
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showToast('success', '📋 Copied to clipboard!');
            }).catch(function() {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                showToast('success', '📋 Copied to clipboard!');
            });
        }

        // ========== TOGGLE FAVOURITE ==========
        function toggleFavourite(phraseId) {
            var btn = document.getElementById('favouriteBtn');
            var icon = document.getElementById('favouriteIcon');
            var text = document.getElementById('favouriteText');
            btn.disabled = true;
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) {
                showToast('danger', 'Security token not found. Please refresh the page.');
                btn.disabled = false;
                return;
            }
            fetch('/Favourites/Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'phraseId=' + phraseId
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.action === 'added') {
                        icon.textContent = '❤️';
                        btn.className = 'btn btn-danger';
                        text.textContent = ' Favourited';
                        showToast('success', '✅ ' + data.message);
                    } else {
                        icon.textContent = '🤍';
                        btn.className = 'btn btn-outline-danger';
                        text.textContent = ' Favourite';
                        showToast('info', '🗑️ ' + data.message);
                    }
                } else {
                    showToast('danger', '❌ ' + (data.message || 'An error occurred.'));
                }
                btn.disabled = false;
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('danger', '❌ An error occurred. Please try again.');
                btn.disabled = false;
            });
        }

        // ========== TOAST NOTIFICATION ==========
        function showToast(type, message) {
            var container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.position = 'fixed';
                container.style.top = '20px';
                container.style.right = '20px';
                container.style.zIndex = '9999';
                container.style.maxWidth = '400px';
                document.body.appendChild(container);
            }
            var toast = document.createElement('div');
            toast.className = 'alert alert-' + type + ' alert-dismissible fade show';
            toast.style.marginTop = '10px';
            toast.style.padding = '12px 20px';
            toast.style.borderRadius = '8px';
            toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
            toast.style.animation = 'slideInRight 0.3s ease';
            toast.innerHTML = message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" onclick="this.parentElement.remove()" style="margin-left:10px;"></button>';
            container.appendChild(toast);
            setTimeout(function() {
                if (toast.parentElement) {
                    toast.style.opacity = '0';
                    toast.style.transition = 'opacity 0.3s ease';
                    setTimeout(function() {
                        if (toast.parentElement) {
                            toast.remove();
                        }
                    }, 300);
                }
            }, 4000);
        }

        // ========== BROWSER TTS ==========
        function speakText(text, language) {
            var btn = event?.target || document.activeElement;
            var originalText = btn.innerText;

            if (!('speechSynthesis' in window)) {
                showToast('warning', 'Your browser does not support text-to-speech.');
                return;
            }

            window.speechSynthesis.cancel();

            var langMap = {
                'en': 'en-US', 'af': 'af-ZA', 'zu': 'zu-ZA', 'xh': 'xh-ZA',
                'st': 'st-ZA', 'nso': 'nso-ZA', 'tn': 'tn-ZA', 'ts': 'ts-ZA',
                'ss': 'ss-ZA', 've': 've-ZA', 'nr': 'nr-ZA'
            };

            var targetLang = langMap[language] || 'en-US';

            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = targetLang;
            utterance.rate = 0.85;
            utterance.pitch = 1.0;
            utterance.volume = 1.0;

            var voices = window.speechSynthesis.getVoices();
            var matchingVoices = voices.filter(function(voice) {
                return voice.lang.startsWith(targetLang.split('-')[0]);
            });

            if (matchingVoices.length > 0) {
                utterance.voice = matchingVoices[0];
            }

            btn.textContent = '🔊 Playing...';
            window.speechSynthesis.speak(utterance);

            utterance.onend = function() {
                btn.textContent = originalText;
            };

            utterance.onerror = function() {
                btn.textContent = originalText;
                showToast('warning', 'Could not play audio. Please try again.');
            };
        }

        // Load voices when page loads
        if ('speechSynthesis' in window) {
            window.speechSynthesis.getVoices();
            window.speechSynthesis.onvoiceschanged = function() {
                window.speechSynthesis.getVoices();
            };
        }
    </script>
}