@using PhraseBookk.Models
@model PhraseBookk.ViewModels.TranslationSubmissionViewModel
@{
    ViewData["Title"] = "Suggest Translation";
}

<div class="container" style="max-width: 720px;">

    <div class="py-4">
        <h2 style="font-weight: 700; color: #1a1a2e;">✍️ Suggest Translation</h2>
        <p style="color: #6c757d;">
            Help other students by translating this phrase.
        </p>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #f8f9fa;">
        <div class="card-body p-4">
            <div style="font-size: 0.8rem; color: #6c757d; font-weight: 500;">Original Phrase</div>
            <div style="font-size: 1.3rem; font-weight: 600; color: #1a1a2e;">
                @Model.PhraseEnglishText
            </div>
            @if (!string.IsNullOrEmpty(Model.PhraseCategoryName))
            {
                <div style="font-size: 0.8rem; color: #6c757d; margin-top: 4px;">
                    📂 Category: @Model.PhraseCategoryName
                </div>
            }
        </div>
    </div>

    <form asp-action="SubmitTranslation" method="post" id="submitTranslationForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PhraseId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Language Selection (Dynamically populated from LanguageCode enum) -->
        <div class="mb-3">
            <label asp-for="Language" class="form-label fw-bold">Select Language</label>
            <select id="languageSelect" asp-for="Language" asp-items="Html.GetEnumSelectList<LanguageCode>()" class="form-select" style="border-radius: 10px;">
                <option value="">-- Select a language --</option>
            </select>
            <span asp-validation-for="Language" class="text-danger"></span>
        </div>

        <!-- 🤖 AI Generate Button -->
        <div class="mb-3 p-3" style="background: #f0f7ff; border-radius: 10px; border: 1px solid #d0e3ff;">
            <div class="d-flex align-items-center gap-3">
                <button type="button" id="generateAiBtn" class="btn btn-primary" style="border-radius: 10px; padding: 8px 20px;">
                    🤖 Generate AI Draft
                </button>
                <span id="aiLoading" style="display: none; color: #6c757d; font-size: 0.9rem;">
                    ⏳ Generating...
                </span>
                <span style="font-size: 0.8rem; color: #6c757d;">
                    AI will generate a draft translation for you to review
                </span>
            </div>
        </div>

        <!-- Translation Text -->
        <div class="mb-3">
            <label asp-for="TranslatedText" class="form-label fw-bold">Your Translation</label>
            <textarea asp-for="TranslatedText" id="translationText" class="form-control" rows="4"
                      placeholder="Type your translation here or use AI to generate a draft..." style="border-radius: 10px; resize: vertical;"></textarea>
            <span asp-validation-for="TranslatedText" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn" style="background: #003057; color: white; padding: 10px 32px; border-radius: 10px; font-weight: 500;">
                Submit Translation
            </button>
            <a asp-action="Details" asp-route-id="@Model.PhraseId" class="btn btn-outline-secondary" style="border-radius: 10px;">
                Cancel
            </a>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('generateAiBtn').addEventListener('click', async function() {
            const languageSelect = document.getElementById('languageSelect');

            // Get the text/name of the selected enum option (or value)
            const selectedOption = languageSelect.options[languageSelect.selectedIndex];
            const language = languageSelect.value;

            console.log('Selected language value:', language);

            if (!language || language === '') {
                alert('Please select a language first.');
                languageSelect.focus();
                return;
            }

            const phraseIdInput = document.querySelector('input[name="PhraseId"]');
            const phraseId = phraseIdInput ? phraseIdInput.value : null;

            if (!phraseId) {
                alert('Error: Phrase ID not found. Please refresh the page.');
                return;
            }

            const loading = document.getElementById('aiLoading');
            const textArea = document.getElementById('translationText');
            const button = this;

            loading.style.display = 'inline';
            button.disabled = true;
            button.textContent = '⏳ Generating...';
            textArea.placeholder = '⏳ AI is generating a translation...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const requestBody = {
                    phraseId: parseInt(phraseId),
                    language: language // Sends the exact value generated by ASP.NET Core
                };

                const response = await fetch('/Phrases/GetAiTranslation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(requestBody)
                });

                const data = await response.json();

                if (data.success) {
                    textArea.value = data.translation;
                    textArea.style.borderColor = '#28a745';
                    textArea.placeholder = 'AI-generated translation - review and edit if needed';
                    setTimeout(() => {
                        textArea.style.borderColor = '';
                    }, 3000);
                } else {
                    alert('❌ AI generation failed: ' + (data.message || 'Unknown error'));
                    textArea.placeholder = 'Type your translation here or try the AI again...';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error: ' + error.message);
                textArea.placeholder = 'Type your translation here or try the AI again...';
            } finally {
                loading.style.display = 'none';
                button.disabled = false;
                button.textContent = '🤖 Generate AI Draft';
            }
        });
    </script>
}