@model IEnumerable<PhraseBookk.Models.UsageStat>
@{
    ViewBag.Title = "Recent Activity";
}

<div class="container mt-4">
    <h2>🕐 Recent Activity</h2>
    <p class="text-muted">Your recent activity from the last 30 minutes.</p>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🕐</div>
            <h3 class="mt-3">No recent activity</h3>
            <p class="text-muted">Search for phrases or view phrases to see them here.</p>
            <a asp-controller="Phrases" asp-action="Index" class="btn btn-primary mt-3">
                🔍 Search for phrases
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Activity</th>
                        <th>Details</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.Action == "View")
                                {
                                    <span class="badge bg-info">👁️ Viewed</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">🔍 Searched</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.SearchKeyword))
                                {
                                    <span><strong>"@item.SearchKeyword"</strong></span>
                                }
                                else if (item.Action == "View" && item.Phrase != null)
                                {
                                    <span><strong>@item.Phrase?.EnglishText</strong></span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@item.Timestamp.ToString("HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small>Showing activity from the last 30 minutes</small>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Phrases" asp-action="Index" class="btn btn-secondary">
            ← Back to search
        </a>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }
</style>