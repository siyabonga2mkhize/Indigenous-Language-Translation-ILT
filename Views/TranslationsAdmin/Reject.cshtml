@model PhraseBookk.Models.Translation
@{
    ViewData["Title"] = "Reject Translation";
}
<div class="container mt-4 mb-5">
    <div class="page-header mb-4">
        <h1><i class="bi bi-x-circle text-danger"></i> Reject Translation</h1>
    </div>

    <div class="alert alert-warning d-flex gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div>
            <strong>Are you sure you want to reject this translation?</strong>
            <p class="mb-0">This will mark it as <strong>Rejected</strong> and it will not appear in search results.</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body p-4">
            <dl class="detail-grid">
                <dt>Phrase</dt>
                <dd>@Model.Phrase?.EnglishText</dd>

                <dt>Language</dt>
                <dd><span class="badge" data-lang="@Model.Language">@Model.Language.ToString()</span></dd>

                <dt>Translation</dt>
                <dd>@Model.TranslatedText</dd>

                <dt>Submitted By</dt>
                <dd>@(Model.SubmittedBy?.FullName ?? "Unknown User")</dd>

                <dt>Submitted Date</dt>
                <dd>@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Reject" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label for="reason" class="form-label fw-bold">Rejection reason (optional)</label>
            <textarea id="reason" name="reason" class="form-control" rows="3" placeholder="e.g. inaccurate translation, grammar issues..."></textarea>
            <small class="text-muted">This will be visible to the student who submitted this translation.</small>
        </div>
        <div class="mt-4 mb-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-x-lg"></i> Confirm rejection
            </button>
            <a asp-action="Pending" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>