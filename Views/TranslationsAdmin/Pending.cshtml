@model IEnumerable<PhraseBookk.Models.Translation>
@{
    ViewData["Title"] = "Pending Translations";
}

<div class="container mt-4 mb-5">
    <div class="page-header mb-4">
        <h1><i class="bi bi-hourglass-split text-warning"></i> Pending Translations</h1>
        <p>Review and approve translation suggestions from students.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-check2-circle"></i></div>
            <h3>All caught up!</h3>
            <p>There are no pending translations waiting for review right now.</p>
        </div>
    }
    else
    {
        <form asp-action="BulkApprove" method="post">
            <div class="d-flex align-items-center mb-3">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-all"></i> Bulk approve selected
                </button>
                <span class="text-muted ms-3 small">Select multiple translations to approve at once.</span>
            </div>

            <div class="table-card table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAll" onchange="toggleCheckboxes(this)" />
                            </th>
                            <th>Phrase</th>
                            <th>Language</th>
                            <th>Translation</th>
                            <th>Submitted By</th>
                            <th>Submitted Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedIds" value="@item.Id" class="translation-checkbox" />
                                </td>
                                <td>
                                    <strong>@item.Phrase?.EnglishText</strong>
                                    <br />
                                    <small class="text-muted">@item.Phrase?.Category?.Name</small>
                                </td>
                                <td><span class="badge" data-lang="@item.Language">@item.Language.ToString()</span></td>
                                <td>@item.TranslatedText</td>
                                <td>@(item.SubmittedBy?.FullName ?? "Unknown User")</td>
                                <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="text-nowrap">
                                    <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-sm btn-success" onclick="return confirm('Approve this translation?')">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </a>
                                    <a asp-action="Reject" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to home
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function toggleCheckboxes(selectAll) {
            var checkboxes = document.getElementsByClassName('translation-checkbox');
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = selectAll.checked;
            }
        }
    </script>
}