@model PhraseBookk.Models.Translation
@{
    ViewData["Title"] = "Translation Details";
}
<div class="container mt-4 mb-5">
    <div class="page-header mb-4">
        <h1><i class="bi bi-file-earmark-text"></i> Translation Details</h1>
        <p>@Model.Language.ToString() translation</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <dl class="detail-grid">
                <dt>Phrase</dt>
                <dd>@Model.Phrase?.EnglishText</dd>

                <dt>Category</dt>
                <dd>@Model.Phrase?.Category?.Name</dd>

                <dt>Language</dt>
                <dd><span class="badge" data-lang="@Model.Language">@Model.Language.ToString()</span></dd>

                <dt>Translation</dt>
                <dd>@Model.TranslatedText</dd>

                <dt>Status</dt>
                <dd>
                    @switch (Model.Status)
                    {
                        case ContentStatus.Pending:
                            <span class="status-pill status-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                            break;
                        case ContentStatus.Approved:
                            <span class="status-pill status-approved"><i class="bi bi-check-circle-fill"></i> Approved</span>
                            break;
                        case ContentStatus.Rejected:
                            <span class="status-pill status-rejected"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                            break;
                    }
                </dd>

                @if (Model.Status == ContentStatus.Rejected && !string.IsNullOrEmpty(Model.AdminReviewComment))
                {
                    <dt>Rejection Reason</dt>
                    <dd>@Model.AdminReviewComment</dd>
                }

                <dt>Submitted By</dt>
                <dd>@(Model.SubmittedBy?.FullName ?? "Unknown User")</dd>

                <dt>Submitted Date</dt>
                <dd>@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

                @if (Model.ReviewedDate.HasValue)
                {
                    <dt>Reviewed Date</dt>
                    <dd>@Model.ReviewedDate?.ToString("dd MMM yyyy HH:mm")</dd>
                }
            </dl>
        </div>
    </div>

    <div class="mt-4 mb-4 d-flex gap-2">
        @if (Model.Status == ContentStatus.Pending)
        {
            <a asp-action="Approve" asp-route-id="@Model.Id" class="btn btn-success" onclick="return confirm('Approve this translation?')">
                <i class="bi bi-check-lg"></i> Approve
            </a>
            <a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-x-lg"></i> Reject
            </a>
        }
        <a asp-action="Pending" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to pending
        </a>
    </div>
</div>