@using PhraseBookk.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Home";
    var phraseOfTheDay = ViewBag.PhraseOfTheDay as PhraseBookk.Models.Phrase;
}

<div class="container" style="max-width: 720px;">

    <!-- ===== HERO ===== -->
    <div class="text-center py-4">
        <h1 style="font-size: 2rem; font-weight: 700; color: #1a1a2e; margin-bottom: 0.25rem;">
            PhraseBook
        </h1>
        <p style="color: #6c757d; font-size: 0.95rem; margin-bottom: 0;">
            All 11 official SA languages.
        </p>
    </div>

    <!-- ===== SEARCH (Primary Action) ===== -->
    <div class="mb-4">
        <form asp-controller="Phrases" asp-action="Index" method="get" id="homeSearchForm">
            <div class="input-group" style="border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <input type="text" name="keyword" id="homeKeyword" class="form-control border-0 py-3"
                       placeholder="Search for a phrase..." style="background: white; font-size: 1rem;" />
                <button type="button" id="homeVoiceSearchBtn" class="btn border-0"
                        style="background: white;" title="Search by voice">
                    🎤
                </button>
                <button type="submit" class="btn" style="background: #003057; color: white; padding: 0 28px; font-weight: 500;">
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- ===== CATEGORIES ===== -->
    <div class="mb-4">
        <div class="row g-2">
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    var icon = cat.Name switch
                    {
                        "Registration" => "🎓",
                        "Accommodation" => "🏠",
                        "Health Services" => "🏥",
                        "Library" => "📚",
                        "Academic Support" => "📖",
                        _ => "📁"
                    };

                    <div class="col-4 col-md-2">
                        <a asp-controller="Phrases" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="text-decoration-none">
                            <div class="text-center py-3 px-2"
                                 style="border-radius: 12px; background: #f8f9fa; transition: background 0.15s ease;"
                                 onmouseover="this.style.background='#e9ecef'"
                                 onmouseout="this.style.background='#f8f9fa'">
                                <div style="font-size: 1.6rem;">@icon</div>
                                <div style="font-size: 0.55rem; color: #1a1a2e; font-weight: 500; margin-top: 2px;">
                                    @cat.Name
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ===== PHRASE OF THE DAY (Compact, Clean) ===== -->
    @if (phraseOfTheDay != null)
    {
        <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px; background: #fafbfc;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div style="font-size: 0.7rem; color: #b8860b; font-weight: 600;">
                            🌟 Phrase of the Day
                        </div>
                        <div style="font-weight: 600; color: #1a1a2e; font-size: 1rem;">
                            @phraseOfTheDay.EnglishText
                        </div>
                        @if (phraseOfTheDay.Translations != null && phraseOfTheDay.Translations.Any(t => t.Status == PhraseBookk.Models.ContentStatus.Approved))
                        {
                            var firstTrans = phraseOfTheDay.Translations.FirstOrDefault(t => t.Status == PhraseBookk.Models.ContentStatus.Approved);
                            if (firstTrans != null)
                            {
                                <div style="font-size: 0.85rem; color: #6c757d;">
                                    @firstTrans.Language.ToString(): @firstTrans.TranslatedText
                                </div>
                            }
                        }
                    </div>
                    <a asp-controller="Phrases" asp-action="Details" asp-route-id="@phraseOfTheDay.Id"
                       style="font-size: 0.75rem; color: #003057; text-decoration: none; white-space: nowrap; margin-left: 12px;">
                        View →
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- ===== QUICK LINKS ===== -->
    <div class="d-flex justify-content-center gap-4 py-2" style="border-top: 1px solid #f0f0f0; border-bottom: 1px solid #f0f0f0;">
        <a asp-controller="Survival" asp-action="Index" style="color: #dc3545; text-decoration: none; font-size: 0.8rem; font-weight: 500;">
            🆘 Survival
        </a>
        <a asp-controller="Favourites" asp-action="Index" style="color: #b8860b; text-decoration: none; font-size: 0.8rem; font-weight: 500;">
            ⭐ Favourites
        </a>
        @if (User.Identity.IsAuthenticated)
        {
            <a asp-controller="Phrases" asp-action="MySubmissions" style="color: #6c757d; text-decoration: none; font-size: 0.8rem; font-weight: 500;">
                📝 My Submissions
            </a>
        }
    </div>

    <!-- ===== FOOTER ===== -->
    <div class="text-center py-3">
        <span style="font-size: 0.65rem; color: #adb5bd;">
            DUT Campus Phrasebook
        </span>
    </div>

</div>

<!-- ===== VOICE SEARCH ===== -->
@section Scripts {
    <script>
        (function () {
            var micBtn = document.getElementById('homeVoiceSearchBtn');
            var keywordInput = document.getElementById('homeKeyword');

            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (!SpeechRecognition) {
                micBtn.disabled = true;
                micBtn.title = "Voice search isn't supported in this browser";
                return;
            }

            var recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            var isListening = false;

            micBtn.addEventListener('click', function () {
                if (isListening) return;
                isListening = true;
                micBtn.innerText = '🔴';
                micBtn.disabled = true;
                recognition.start();
            });

            recognition.onresult = function (event) {
                var spokenText = event.results[0][0].transcript;
                keywordInput.value = spokenText;
                document.getElementById('homeSearchForm').submit();
            };

            recognition.onerror = function (event) {
                console.warn('Voice search error:', event.error);
                alert("Sorry, I couldn't catch that. Please try again or type your search.");
            };

            recognition.onend = function () {
                isListening = false;
                micBtn.innerText = '🎤';
                micBtn.disabled = false;
            };
        })();
    </script>
}