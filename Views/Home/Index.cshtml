@{
    ViewData["Title"] = "Home Page";
    var phraseOfTheDay = ViewBag.PhraseOfTheDay as PhraseBookk.Models.Phrase;
}

<div class="container mt-4">

    <!-- Welcome & Hero -->
    <div class="text-center">
        <h1 class="display-4">Welcome to PhraseBook</h1>
        <p class="lead text-muted">Your campus phrasebook for all 11 official South African languages.</p>
    </div>

    <!-- Quick Search -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Quick search</h5>
                    <form asp-controller="Phrases" asp-action="Index" method="get" id="homeSearchForm">
                        <div class="input-group">
                            <input type="text" name="keyword" id="homeKeyword" class="form-control" placeholder="Search for a phrase..." />
                            <button type="button" id="homeVoiceSearchBtn" class="btn btn-outline-secondary" title="Search by voice">🎤</button>
                            <button type="submit" class="btn btn-primary">Search</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Cards -->
    <div class="row mt-4">
        <div class="col-12">
            <h5>Browse by category</h5>
            <div class="row g-2">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        // Assign unique icon based on category name
                        var icon = cat.Name switch
                        {
                            "Registration" => "🎓",
                            "Accommodation" => "🏠",
                            "Health Services" => "🏥",
                            "Library" => "📚",
                            "Academic Support" => "📖",
                            _ => "📁"
                        };

                        <div class="col-md-2 col-4">
                            <a asp-controller="Phrases" asp-action="Index" asp-route-categoryId="@cat.Id" class="text-decoration-none">
                                <div class="card h-100 text-center p-2 shadow-sm category-card">
                                    <div class="card-body">
                                        <span style="font-size: 2.5rem;">@icon</span>
                                        <p class="small fw-bold mt-1 mb-0">@cat.Name</p>
                                        @if (!string.IsNullOrEmpty(cat.Latitude))
                                        {
                                            <small class="text-muted">📍</small>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Phrase of the Day -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card border-warning shadow-lg">
                <div class="card-header bg-warning text-dark">
                    <strong>Phrase of the day</strong>
                    <span class="float-end small">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                </div>
                <div class="card-body text-start">
                    @if (phraseOfTheDay != null)
                    {
                        <h3 class="card-title">@phraseOfTheDay.EnglishText</h3>
                        <p class="text-muted">
                            <span class="badge" data-lang="@phraseOfTheDay.Category?.Name">@phraseOfTheDay.Category?.Name</span>
                        </p>
                        <hr />
                        <h6>Translations:</h6>
                        @if (phraseOfTheDay.Translations != null && phraseOfTheDay.Translations.Any(t => t.Status == PhraseBookk.Models.ContentStatus.Approved))
                        {
                            <ul class="list-unstyled">
                                @foreach (var trans in phraseOfTheDay.Translations.Where(t => t.Status == PhraseBookk.Models.ContentStatus.Approved))
                                {
                                    <li class="mb-1">
                                        <span class="badge" data-lang="@trans.Language.ToString()">@trans.Language.ToString()</span>
                                        @trans.TranslatedText
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No approved translations yet.</p>
                        }
                        <div class="mt-3">
                            <a asp-controller="Phrases" asp-action="Details" asp-route-id="@phraseOfTheDay.Id" class="btn btn-outline-primary">
                                View full phrase →
                            </a>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Phrases" asp-action="SubmitTranslation" asp-route-id="@phraseOfTheDay.Id" class="btn btn-outline-success ms-2">
                                    Suggest a translation
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary ms-2">
                                    Login to suggest
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No phrases available. Please check back later.</p>
                    }
                </div>
                <div class="card-footer text-muted small">
                    Phrase of the day updates daily. Check back tomorrow for a new phrase.
                </div>
            </div>
        </div>
    </div>

    <!-- Features -->
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; color: var(--indigo, #4338ca);">🔍</div>
                    <h5>Search phrases</h5>
                    <p class="text-muted">Search across 11 languages with highlighting.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; color: var(--amber, #d97706);">✍️</div>
                    <h5>Suggest translations</h5>
                    <p class="text-muted">Help others by submitting translations.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; color: var(--indigo, #4338ca);">⭐</div>
                    <h5>Save favourites</h5>
                    <p class="text-muted">Save phrases you use often.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Quick Stats -->
    @if (User.Identity.IsAuthenticated && User.IsInRole("Administrator"))
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <strong>Admin quick stats</strong>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <h4>@ViewBag.PendingCount</h4>
                                <p class="text-muted">Pending translations</p>
                            </div>
                            <div class="col-md-3">
                                <h4>@ViewBag.TotalPhrases</h4>
                                <p class="text-muted">Total phrases</p>
                            </div>
                            <div class="col-md-3">
                                <h4>@ViewBag.TotalTranslations</h4>
                                <p class="text-muted">Total translations</p>
                            </div>
                            <div class="col-md-3">
                                <a asp-controller="PhrasesAdmin" asp-action="Index" class="btn btn-primary">
                                    Go to dashboard →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .category-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 12px;
        border: 1px solid #f0f0f0;
    }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            border-color: #003057;
        }
</style>

<!--For Voice Input Search-->
@section Scripts {
    <script>
        (function () {
            var micBtn = document.getElementById('homeVoiceSearchBtn');
            var keywordInput = document.getElementById('homeKeyword');

            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (!SpeechRecognition) {
                micBtn.disabled = true;
                micBtn.title = "Voice search isn't supported in this browser";
                return;
            }

            var recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            var isListening = false;

            micBtn.addEventListener('click', function () {
                if (isListening) return;
                isListening = true;
                micBtn.innerText = '🔴';
                micBtn.disabled = true;
                recognition.start();
            });

            recognition.onresult = function (event) {
                var spokenText = event.results[0][0].transcript;
                keywordInput.value = spokenText;
                document.getElementById('homeSearchForm').submit();
            };

            recognition.onerror = function (event) {
                console.warn('Voice search error:', event.error);
                alert("Sorry, I couldn't catch that. Please try again or type your search.");
            };

            recognition.onend = function () {
                isListening = false;
                micBtn.innerText = '🎤';
                micBtn.disabled = false;
            };
        })();
    </script>
}